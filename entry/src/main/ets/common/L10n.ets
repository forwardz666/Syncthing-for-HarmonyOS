export class L10n {
  private static currentLocale: string = 'zh-CN';

  static setLocale(locale: string): void {
    L10n.currentLocale = L10n.resolveLocale(locale);
    Logger.i(TAG, `Locale: ${L10n.currentLocale}`);
  }

  // 'system' resolves to the real system language instead of hardcoding zh-CN.
  private static resolveLocale(pref: string): string {
    if (pref === 'system') {
      try {
        const lang = i18n.System.getSystemLanguage().toLowerCase();
        if (lang.startsWith('zh')) {
          return 'zh-CN';
        }
        if (lang.startsWith('en')) {
          return 'en-US';
        }
        return 'zh-CN';
      } catch (err) {
        Logger.w(TAG, `Failed to read system language, default zh-CN: ${JSON.stringify(err)}`);
        return 'zh-CN';
      }
    }
    return pref === 'en-US' ? 'en-US' : 'zh-CN';
  }

  static getCurrentLocale(): string {
    return L10n.currentLocale;
  }

  static t(name: string, ...args: Array<string | number>): string {
    const clean = name.startsWith('app.string.') ? name.substring('app.string.'.length) : name;
    const dict = L10n.currentLocale === 'zh-CN' ? getZH() : getEN();
    let val = dict[clean];
    if (val === undefined) {
      val = getEN()[clean];
      if (val === undefined) {
        val = getZH()[clean];
        if (val === undefined) return clean;
      }
    }
    // Substitute %s / %d placeholders in order (so multi-arg templates like
    // '%s 由 %s 提供' work), then collapse '%%' escapes ('%d%% 已同步' -> '42% 已同步').
    let idx = 0;
    val = val.replace(/%s|%d/g, (m: string) => {
      if (idx < args.length) {
        return String(args[idx++]);
      }
      return m;
    });
    val = val.replace(/%%/g, '%');
    return val;
  }

  static fmt(name: string, ...args: Array<string | number>): string {
    return L10n.t(name, ...args);
  }

  // Maps known Syncthing core folder states to the active locale; unknown
  // states pass through unchanged (they are core data).
  static folderState(state: string): string {
    const mapped: Record<string, string> = {
      'idle': L10n.t('app.string.state_idle'),
      'scanning': L10n.t('app.string.state_scanning'),
      'syncing': L10n.t('app.string.state_syncing'),
      'sync-preparing': L10n.t('app.string.state_preparing'),
      'sync-waiting': L10n.t('app.string.state_waiting'),
      'wait-to-sync': L10n.t('app.string.state_waiting'),
      'prepare-to-sync': L10n.t('app.string.state_preparing'),
      'sync-scanning': L10n.t('app.string.state_scanning'),
      'cleanup': L10n.t('app.string.state_cleanup'),
      'error': L10n.t('app.string.state_error'),
      'unknown': L10n.t('app.string.unknown'),
      'paused': L10n.t('app.string.paused')
    };
    return mapped[state] !== undefined ? mapped[state] : state;
  }
}
