{
  "app": {
    // NOTE: Signing material is intentionally omitted from this checked-in file.
    // Add your own local signingConfigs (via DevEco Studio "Signing Configs" or
    // a local override) to produce a signed build. An unsigned HAP can be built
    // without any signing config.
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "6.0.0(20)",
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
